<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Photo Map</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<style>
  :root{
    --bg:#f4f2ee; --panel:#ffffff; --ink:#1c1b19; --muted:#6b6a67;
    --accent:#c1440e; --border:#e3e0da; --hover:#f8f1ec;
  }
  @media (prefers-color-scheme: dark){
    :root{ --bg:#171614; --panel:#211f1c; --ink:#f2f0ec; --muted:#a19e97;
      --accent:#e8794f; --border:#38352f; --hover:#2b2824; }
  }
  *{ box-sizing:border-box; }
  html,body{ margin:0; height:100%; background:var(--bg); color:var(--ink);
    font-family:-apple-system,BlinkMacSystemFont,"SF Pro Text",Helvetica,Arial,sans-serif; }
  #app{ display:flex; height:100%; position:relative; }
  #sidebar{ width:220px; min-width:220px; background:var(--panel); border-right:1px solid var(--border);
    display:flex; flex-direction:column; }
  header{ padding:12px 14px 10px; border-bottom:1px solid var(--border); }
  header h1{ margin:0 0 4px; font-size:15px; font-weight:600; }
  header p{ margin:0; font-size:11px; color:var(--muted); }
  #list{ overflow-y:auto; flex:1; }
  .item{ display:flex; gap:8px; padding:8px 10px; cursor:pointer; border-bottom:1px solid var(--border); }
  .item:hover{ background:var(--hover); }
  .item img{ width:38px; height:38px; object-fit:cover; border-radius:5px; flex-shrink:0; background:var(--border); }
  .thumb-wrap{ position:relative; flex-shrink:0; }
  .item-thumb{ width:38px; height:38px; }
  .play-badge{ position:absolute; inset:0; display:flex; align-items:center; justify-content:center;
    color:#fff; font-size:11px; text-shadow:0 0 3px rgba(0,0,0,.8); pointer-events:none; }
  .item .meta{ min-width:0; }
  .item .date{ font-size:11px; font-weight:600; }
  .item .name{ font-size:10px; color:var(--muted); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .year-header{ position:sticky; top:0; background:var(--panel); padding:6px 10px; font-size:11px;
    font-weight:700; color:var(--accent); border-bottom:1px solid var(--border); letter-spacing:0.03em;
    z-index:1; cursor:pointer; display:flex; align-items:center; justify-content:space-between;
    user-select:none; }
  .year-header:hover{ background:var(--hover); }
  .year-header .chevron{ display:inline-block; transition:transform .15s ease; font-size:9px; color:var(--muted); }
  .year-header.collapsed .chevron{ transform:rotate(-90deg); }
  .year-items{ overflow:hidden; }
  .year-items.collapsed{ display:none; }
  #map{ flex:1; }
  .popup-card{ width:200px; font-family:-apple-system,BlinkMacSystemFont,"SF Pro Text",Helvetica,Arial,sans-serif; }
  .popup-card img{ width:100%; border-radius:6px; display:block; margin-bottom:6px; }
  .popup-card .thumb-wrap{ width:100%; }
  .popup-card .play-badge{ font-size:28px; margin-bottom:6px; }
  .popup-card .date{ font-size:12.5px; font-weight:600; margin-bottom:2px; }
  .popup-card .name{ font-size:10.5px; color:#666; margin-bottom:8px; word-break:break-all; }
  .popup-card a{ display:inline-block; font-size:12px; color:#c1440e; text-decoration:none; margin-right:10px; }
  .popup-card a:hover{ text-decoration:underline; }
  .cluster-popup{ width:200px; font-family:-apple-system,BlinkMacSystemFont,"SF Pro Text",Helvetica,Arial,sans-serif; }
  .cluster-popup .cluster-title{ font-size:11.5px; font-weight:700; margin-bottom:6px; color:#333; }
  .cluster-grid{ display:grid; grid-template-columns:repeat(4, 1fr); gap:4px; max-height:220px; overflow-y:auto; }
  .cluster-grid a{ display:block; }
  .cluster-grid img{ width:100%; aspect-ratio:1; object-fit:cover; border-radius:4px; display:block; background:#eee; }
  .cluster-more{ font-size:10px; color:#888; margin-top:6px; text-align:center; }

  body{ display:flex; flex-direction:column; }
  #tabbar{ display:flex; gap:2px; background:var(--panel); border-bottom:1px solid var(--border);
    padding:0 8px; flex-shrink:0; }
  .tab-btn{ border:0; background:none; padding:10px 16px 9px; font-size:13px; font-weight:600;
    color:var(--muted); cursor:pointer; border-bottom:2px solid transparent; font-family:inherit; }
  .tab-btn:hover{ color:var(--ink); }
  .tab-btn.active{ color:var(--accent); border-bottom-color:var(--accent); }
  #app{ flex:1; min-height:0; }
  #app.hidden{ display:none; }

  #gallery-view{ flex:1; min-height:0; overflow-y:auto; background:var(--bg); }
  #gallery-view.hidden{ display:none; }
  #gallery-header{ padding:12px 16px 2px; font-size:11px; color:var(--muted); }
  #gallery-grid{ display:grid; grid-template-columns:repeat(auto-fill, minmax(200px, 1fr));
    gap:16px; padding:14px 16px 24px; }
  .g-card{ background:var(--panel); border:1px solid var(--border); border-radius:8px; overflow:hidden;
    cursor:pointer; transition:transform .12s ease, box-shadow .12s ease; }
  .g-card:hover{ transform:translateY(-2px); box-shadow:0 4px 14px rgba(0,0,0,.14); }
  .g-thumb-wrap{ position:relative; width:100%; aspect-ratio:1; background:var(--border); }
  .g-thumb-wrap img{ width:100%; height:100%; object-fit:cover; display:block; }
  .g-thumb-wrap .play-badge{ font-size:26px; }
  .g-caption{ padding:8px 10px 10px; }
  .g-date{ font-size:12px; font-weight:600; }
  .g-name{ font-size:10.5px; color:var(--muted); white-space:nowrap; overflow:hidden;
    text-overflow:ellipsis; margin-top:1px; }
  .g-location{ font-size:10.5px; color:var(--accent); margin-top:3px; white-space:nowrap;
    overflow:hidden; text-overflow:ellipsis; }
  .g-location.pending{ color:var(--muted); font-style:italic; }

  #lightbox{ position:fixed; inset:0; background:rgba(10,9,8,.92); z-index:1000; display:none;
    align-items:center; justify-content:center; }
  #lightbox.open{ display:flex; }
  #lb-content{ display:flex; flex-direction:column; align-items:center; max-width:92vw; max-height:92vh; }
  #lb-image-wrap{ position:relative; display:flex; align-items:center; justify-content:center; max-height:76vh; }
  #lb-image{ max-width:92vw; max-height:76vh; object-fit:contain; border-radius:6px; display:block;
    box-shadow:0 8px 40px rgba(0,0,0,.5); background:#111; }
  #lb-video-badge{ font-size:48px; }
  #lb-info{ color:#f2f0ec; text-align:center; margin-top:14px; max-width:640px; }
  #lb-date{ font-size:15px; font-weight:600; }
  #lb-location{ font-size:13px; color:#e8794f; margin-top:3px; }
  #lb-location.pending{ color:#a19e97; font-style:italic; }
  #lb-name{ font-size:11.5px; color:#a19e97; margin-top:4px; word-break:break-all; }
  #lb-links{ margin-top:8px; }
  #lb-links a{ color:#e8794f; font-size:12.5px; text-decoration:none; margin:0 8px; }
  #lb-links a:hover{ text-decoration:underline; }
  #lb-close, #lb-prev, #lb-next{ position:absolute; background:rgba(255,255,255,.08); border:0; color:#fff;
    cursor:pointer; border-radius:50%; display:flex; align-items:center; justify-content:center;
    font-size:20px; line-height:1; }
  #lb-close:hover, #lb-prev:hover, #lb-next:hover{ background:rgba(255,255,255,.18); }
  #lb-close{ top:18px; right:18px; width:38px; height:38px; }
  #lb-prev, #lb-next{ top:50%; transform:translateY(-50%); width:52px; height:52px; font-size:28px; }
  #lb-prev{ left:18px; }
  #lb-next{ right:18px; }
</style>
</head>
<body>
<div id="tabbar">
  <button class="tab-btn active" data-tab="app">🗺️ Map</button>
  <button class="tab-btn" data-tab="gallery-view">🖼️ Gallery</button>
</div>
<div id="app">
  <div id="sidebar">
    <header>
      <h1>📍 Photo Map</h1>
      <p id="count"></p>
    </header>
    <div id="list"></div>
  </div>
  <div id="map"></div>
</div>
<div id="gallery-view" class="hidden">
  <div id="gallery-header"><span id="gallery-count"></span></div>
  <div id="gallery-grid"></div>
</div>

<div id="lightbox">
  <button id="lb-close" title="Close (Esc)">✕</button>
  <button id="lb-prev" title="Previous (←)">‹</button>
  <button id="lb-next" title="Next (→)">›</button>
  <div id="lb-content">
    <div id="lb-image-wrap">
      <img id="lb-image" alt="">
      <div id="lb-video-badge" class="play-badge" style="display:none;">▶</div>
    </div>
    <div id="lb-info">
      <div id="lb-date"></div>
      <div id="lb-location"></div>
      <div id="lb-name"></div>
      <div id="lb-links">
        <a id="lb-open" href="#" target="_blank">Open full photo</a>
        <a id="lb-apple" href="#" target="_blank">Apple Maps</a>
      </div>
    </div>
  </div>
</div>

<script>
