t": 48.872014, "lon": 2.324689, "date": "2026-07-11 19:51", "sort": "2026:07:11 19:51:24", "thumb": "", "video": false}, {"file": "photo-261.jpg", "year": "2026", "lat": 48.872014, "lon": 2.324689, "date": "2026-07-11 20:43", "sort": "2026:07:11 20:43:48", "thumb": "", "video": false}, {"file": "photo-355.jpg", "year": "2026", "lat": 48.872014, "lon": 2.324689, "date": "2026-07-11 20:51", "sort": "2026:07:11 20:51:27", "thumb": "", "video": false}, {"file": "photo-354.jpg", "year": "2026", "lat": 48.872014, "lon": 2.324689, "date": "2026-07-11 20:51", "sort": "2026:07:11 20:51:34", "thumb": "", "video": false}, {"file": "IMG_0679.jpeg", "year": "2026", "lat": 46.948728, "lon": 7.389539, "date": "2026-07-16 16:09", "sort": "2026:07:16 16:09:50", "thumb": "", "video": false}, {"file": "IMG_6809.JPG", "year": "2026", "lat": 46.967194, "lon": 7.385172, "date": "2026-07-17 12:49", "sort": "2026:07:17 12:49:08", "thumb": "", "video": false}];
document.getElementById('count').textContent = RECORDS.length + " photos located";
document.getElementById('gallery-count').textContent = RECORDS.length + " photos";

// ---------- Tabs ----------
const tabButtons = document.querySelectorAll('.tab-btn');
const appView = document.getElementById('app');
const galleryView = document.getElementById('gallery-view');
let galleryBuilt = false;

tabButtons.forEach((btn) => {
  btn.addEventListener('click', () => {
    tabButtons.forEach((b) => b.classList.remove('active'));
    btn.classList.add('active');
    const showGallery = btn.dataset.tab === 'gallery-view';
    appView.classList.toggle('hidden', showGallery);
    galleryView.classList.toggle('hidden', !showGallery);
    if (showGallery && !galleryBuilt) buildGallery();
  });
});

// ---------- Reverse geocoding (OpenStreetMap Nominatim, cached + throttled to <1 req/sec) ----------
const GEO_CACHE_KEY = 'photoMapGeoCache';
let geoCache = {};
try { geoCache = JSON.parse(localStorage.getItem(GEO_CACHE_KEY) || '{}'); } catch (e) { geoCache = {}; }
let geoQueue = Promise.resolve();

function geoKey(lat, lon) { return lat.toFixed(3) + ',' + lon.toFixed(3); }

function formatPlace(data) {
  if (!data || !data.address) return null;
  const a = data.address;
  const place = a.village || a.town || a.city || a.municipality || a.county || a.state || '';
  const country = a.country || '';
  return [place, country].filter(Boolean).join(', ') || data.display_name || null;
}

function reverseGeocode(lat, lon, onResult) {
  const key = geoKey(lat, lon);
  if (geoCache[key] !== undefined) { onResult(geoCache[key]); return; }
  geoQueue = geoQueue.then(() => new Promise((resolve) => {
    fetch(`https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat=${lat}&lon=${lon}&zoom=12&addressdetails=1`)
      .then((r) => r.json())
      .then((data) => {
        const label = formatPlace(data);
        geoCache[key] = label;
        try { localStorage.setItem(GEO_CACHE_KEY, JSON.stringify(geoCache)); } catch (e) {}
        onResult(label);
      })
      .catch(() => { onResult(null); })
      .finally(() => setTimeout(resolve, 1100));
  }));
}

// ---------- Gallery tab ----------
const galleryGrid = document.getElementById('gallery-grid');

function buildGallery() {
  galleryBuilt = true;
  const frag = document.createDocumentFragment();
  RECORDS.forEach((r, i) => {
    const thumbSrc = "data:image/jpeg;base64," + r.thumb;
    const playBadge = r.video ? `<div class="play-badge">▶</div>` : '';
    const card = document.createElement('div');
    card.className = 'g-card';
    card.innerHTML = `
      <div class="g-thumb-wrap">${playBadge}<img src="${thumbSrc}" alt="" loading="lazy"></div>
      <div class="g-caption">
        <div class="g-date">${r.date}</div>
        <div class="g-name">${r.file}</div>
        <div class="g-location pending">Locating…</div>
      </div>`;
    card.addEventListener('click', () => openLightbox(i));

    const locEl = card.querySelector('.g-location');
    const io = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          io.disconnect();
          reverseGeocode(r.lat, r.lon, (label) => {
            locEl.classList.remove('pending');
            locEl.textContent = label || (r.lat.toFixed(4) + ', ' + r.lon.toFixed(4));
          });
        }
      });
    }, { rootMargin: '200px' });
    io.observe(card);

    frag.appendChild(card);
  });
  galleryGrid.appendChild(frag);
}

// ---------- Lightbox (big view) ----------
const lightbox = document.getElementById('lightbox');
const lbImage = document.getElementById('lb-image');
const lbVideoBadge = document.getElementById('lb-video-badge');
const lbDate = document.getElementById('lb-date');
const lbLocation = document.getElementById('lb-location');
const lbName = document.getElementById('lb-name');
const lbOpen = document.getElementById('lb-open');
const lbApple = document.getElementById('lb-apple');
let lbIndex = -1;

function openLightbox(i) {
  lbIndex = i;
  const r = RECORDS[i];
  const fileHref = r.year + "/" + encodeURIComponent(r.file).replace(/%2F/g, '/');
  const thumbSrc = "data:image/jpeg;base64," + r.thumb;

  lbImage.src = thumbSrc;
  if (!r.video) {
    const fullImg = new Image();
    fullImg.onload = () => { if (lbIndex === i) lbImage.src = fileHref; };
    fullImg.src = fileHref;
  }
  lbVideoBadge.style.display = r.video ? 'flex' : 'none';

  lbDate.textContent = r.date;
  lbName.textContent = r.file;
  lbLocation.className = 'pending';
  lbLocation.textContent = 'Locating…';
  reverseGeocode(r.lat, r.lon, (label) => {
    if (lbIndex !== i) return;
    lbLocation.className = '';
    lbLocation.textContent = label || (r.lat.toFixed(4) + ', ' + r.lon.toFixed(4));
  });

  lbOpen.href = fileHref;
  lbOpen.textContent = r.video ? 'Play video' : 'Open full photo';
  lbApple.href = "https://maps.apple.com/?ll=" + r.lat + "," + r.lon + "&q=" + encodeURIComponent(r.file);

  lightbox.classList.add('open');
}

function closeLightbox() { lightbox.classList.remove('open'); lbIndex = -1; }
function showRelative(delta) {
  if (lbIndex < 0) return;
  openLightbox((lbIndex + delta + RECORDS.length) % RECORDS.length);
}

document.getElementById('lb-close').addEventListener('click', closeLightbox);
document.getElementById('lb-prev').addEventListener('click', () => showRelative(-1));
document.getElementById('lb-next').addEventListener('click', () => showRelative(1));
lightbox.addEventListener('click', (e) => { if (e.target === lightbox) closeLightbox(); });
document.addEventListener('keydown', (e) => {
  if (!lightbox.classList.contains('open')) return;
  if (e.key === 'Escape') closeLightbox();
  else if (e.key === 'ArrowLeft') showRelative(-1);
  else if (e.key === 'ArrowRight') showRelative(1);
});

let map, infoWindow;
const listEl = document.getElementById('list');
const gMarkers = [];

function initMap() {
  map = new google.maps.Map(document.getElementById('map'), {
    center: { lat: 45.7, lng: 5.9 },
    zoom: 8,
    mapTypeControl: true,
    streetViewControl: true,
    fullscreenControl: true,
  });
  infoWindow = new google.maps.InfoWindow();

  // hover-friendly open/close: a short close delay lets the cursor travel from
  // the marker into the popup without it flickering shut, and re-entering the
  // popup content itself (once google renders it) cancels the pending close.
  let closeTimer = null;
  const cancelClose = () => { clearTimeout(closeTimer); };
  const scheduleClose = () => { clearTimeout(closeTimer); closeTimer = setTimeout(() => infoWindow.close(), 250); };
  const openPopup = (anchor, html) => { cancelClose(); infoWindow.setContent(html); infoWindow.open({ anchor, map }); };
  infoWindow.addListener('domready', () => {
    document.querySelectorAll('.popup-card, .cluster-popup').forEach((el) => {
      const root = el.closest('.gm-style-iw') || el;
      root.addEventListener('mouseenter', cancelClose);
      root.addEventListener('mouseleave', scheduleClose);
    });
  });

  function buildClusterPopup(recs) {
    const shown = recs.slice(0, 24);
    const extra = recs.length - shown.length;
    const thumbs = shown.map((r) => {
      const thumbSrc = "data:image/jpeg;base64," + r.thumb;
      const fileHref = r.year + "/" + encodeURIComponent(r.file).replace(/%2F/g, '/');
      return `<a href="${fileHref}" target="_blank" title="${r.file} — ${r.date}"><img src="${thumbSrc}" alt=""></a>`;
    }).join('');
    const more = extra > 0 ? `<div class="cluster-more">+${extra} more</div>` : '';
    return `<div class="cluster-popup"><div class="cluster-title">${recs.length} photos here</div><div class="cluster-grid">${thumbs}</div>${more}</div>`;
  }

  const bounds = new google.maps.LatLngBounds();
  let lastYear = null;
  let currentGroup = null;

  RECORDS.forEach((r) => {
    if (r.year !== lastYear) {
      lastYear = r.year;
      const yearHeader = document.createElement('div');
      yearHeader.className = 'year-header collapsed';
      yearHeader.innerHTML = `<span>${r.year}</span><span class="chevron">▼</span>`;

      const group = document.createElement('div');
      group.className = 'year-items collapsed';
      currentGroup = group;

      yearHeader.addEventListener('click', () => {
        const collapsed = group.classList.toggle('collapsed');
        yearHeader.classList.toggle('collapsed', collapsed);
      });

      listEl.appendChild(yearHeader);
      listEl.appendChild(group);
    }

    const pos = { lat: r.lat, lng: r.lon };
    const marker = new google.maps.Marker({ position: pos, map, title: r.file });
    marker.set('record', r);
    bounds.extend(pos);
    gMarkers.push(marker);

    const appleUrl = "https://maps.apple.com/?ll=" + r.lat + "," + r.lon +
      "&q=" + encodeURIComponent(r.file);
    const fileHref = r.year + "/" + encodeURIComponent(r.file).replace(/%2F/g, '/');
    const thumbSrc = "data:image/jpeg;base64," + r.thumb;
    const playBadge = r.video ? `<div class="play-badge">▶</div>` : '';
    const openLabel = r.video ? 'Play video' : 'Open full photo';

    const popupHtml = `
      <div class="popup-card">
        <div class="thumb-wrap">${playBadge}<img src="${thumbSrc}" alt=""></div>
        <div class="date">${r.date}</div>
        <div class="name">${r.file}</div>
        <a href="${fileHref}" target="_blank">${openLabel}</a>
        <a href="${appleUrl}" target="_blank">Apple Maps</a>
      </div>`;

    marker.addListener('mouseover', () => openPopup(marker, popupHtml));
    marker.addListener('mouseout', scheduleClose);
    marker.addListener('click', () => openPopup(marker, popupHtml));

    const item = document.createElement('div');
    item.className = 'item';
    item.innerHTML = `
      <div class="thumb-wrap item-thumb">${playBadge}<img src="${thumbSrc}" alt=""></div>
      <div class="meta">
        <div class="date">${r.date}</div>
        <div class="name">${r.file}</div>
      </div>`;
    item.addEventListener('click', () => {
      map.panTo(pos);
      map.setZoom(15);
      google.maps.event.trigger(marker, 'click');
    });
    currentGroup.appendChild(item);
  });

  if (typeof markerClusterer !== 'undefined') {
    new markerClusterer.MarkerClusterer({
      map,
      markers: gMarkers,
      renderer: {
        render: ({ count, position, markers: clusterMarkers }) => {
          const clusterMarker = new google.maps.Marker({
            position,
            icon: {
              url: 'data:image/svg+xml;charset=UTF-8,' + encodeURIComponent(
                `<svg xmlns="http://www.w3.org/2000/svg" width="44" height="44">
                   <circle cx="22" cy="22" r="20" fill="#c1440e" fill-opacity="0.85" stroke="white" stroke-width="2"/>
                 </svg>`
              ),
              scaledSize: new google.maps.Size(44, 44),
              anchor: new google.maps.Point(22, 22),
            },
            label: { text: String(count), color: '#fff', fontSize: '13px', fontWeight: '700' },
            zIndex: 1000 + count,
          });
          clusterMarker.addListener('mouseover', () => {
            const recs = clusterMarkers.map((m) => m.get('record')).filter(Boolean);
            openPopup(clusterMarker, buildClusterPopup(recs));
          });
          clusterMarker.addListener('mouseout', scheduleClose);
          clusterMarker.addListener('click', () => {
            const clusterBounds = new google.maps.LatLngBounds();
            clusterMarkers.forEach((m) => clusterBounds.extend(m.getPosition()));
            map.fitBounds(clusterBounds, 60);
          });
          return clusterMarker;
        },
      },
    });
  }

  if (RECORDS.length) {
    map.fitBounds(bounds, 40);
  }

  const rescaleBtn = document.createElement('button');
  rescaleBtn.textContent = '⤢ Fit all photos';
  rescaleBtn.title = 'Rescale map to show every photo';
  rescaleBtn.style.cssText = `
    background:#fff; border:0; border-radius:2px; box-shadow:0 1px 4px rgba(0,0,0,.3);
    margin:10px; padding:8px 12px; font-size:13px; font-family:Roboto,Arial,sans-serif;
    cursor:pointer; color:#333;`;
  rescaleBtn.addEventListener('click', () => {
    if (RECORDS.length) map.fitBounds(bounds, 40);
  });
  rescaleBtn.addEventListener('mouseenter', () => rescaleBtn.style.background = '#f1f1f1');
  rescaleBtn.addEventListener('mouseleave', () => rescaleBtn.style.background = '#fff');
  map.controls[google.maps.ControlPosition.TOP_RIGHT].push(rescaleBtn);
}
window.initMap = initMap;
</script>
<script src="https://unpkg.com/@googlemaps/markerclusterer/dist/index.min.js"></script>
<script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyCulY5XE2gT6cB4rVbrA9b0WbFtXVuqEMw&callback=initMap&v=weekly" async defer></script>
</body>
</html>
